# ---- PharmaSense AI configuration -------------------------------------------
# Free Groq API key: https://console.groq.com/keys   (no credit card needed)
GROQ_API_KEY=""

# Models - all usable on Groq's FREE tier (rate-limited, no payment). Groq retired the old Llama 3.x IDs on
# 2026-08-16. If a model is ever removed again, the app auto-discovers a working one; or pick from
# https://console.groq.com/docs/models
MODEL_ROUTER=openai/gpt-oss-20b
MODEL_AGENT=openai/gpt-oss-120b
MODEL_WRITER=openai/gpt-oss-120b
# Used automatically if the main model hits a rate limit / daily token cap:
MODEL_FALLBACK=openai/gpt-oss-20b
# gpt-oss reasoning depth: low (fast, saves free-tier tokens) | medium | high
REASONING_EFFORT=low

# Optional tuning
MAX_TOOL_ITERATIONS=5
MAX_PARALLEL_AGENTS=3
SQL_MAX_ROWS=100
